    <!-- Rudder -->
    <link name="rudder">
      <pose>-1.636 0 0.058 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.0016</mass>
        <inertia>
          <ixx>0.000001</ixx>
          <ixy>0.0</ixy>
          <ixz>0.0</ixz>
          <iyy>0.000001</iyy>
          <iyz>0.0</iyz>
          <izz>0.000001</izz>
        </inertia>
      </inertial>
      <visual name='rudder_visual'>
        <pose>1.636 0 -0.058 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://fighter_vtol_hitl/meshes/gz_fighter_vtol_rudder_v2.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1 1</ambient>
          <diffuse>0 0 1 1</diffuse>
        </material>
      </visual>
    </link>
    <joint name='rudder_joint' type='revolute'>
      <!-- global (-0.886,-0.008,z): x=-0.886-(-1.636)=0.75 -->
      <pose>0.75 0 0 0 0 0</pose>
      <parent>base_link</parent>
      <child>rudder</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-0.78</lower>
          <upper>0.78</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
          <implicit_spring_damper>1</implicit_spring_damper>
        </ode>
      </physics>
    </joint>

    <!-- ============================================================ -->
    <!-- AERODYNAMICS PLUGINS (libLiftDragPlugin.so)                  -->
    <!-- Parameters translated directly from gz-sim LiftDrag system;  -->
    <!-- parameter names are identical between the two versions.      -->
    <!-- Added: robotNamespace, windSubTopic (Classic-only fields).   -->
    <!-- ============================================================ -->

    <!-- Left aileron wing (NACA-5411) -->
    <plugin name="left_aileron_lift" filename="libLiftDragPlugin.so">
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <!-- 309*515 + (309+280)*700/2 ~= 365285mm² = 0.365m² -->
      <area>0.365</area>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>-0.05 0.3 0.05</cp>
      <a0>0.08727</a0>             <!-- 5 deg in rad -->
      <cla>6.19</cla>              <!-- 0.1081/deg * (180/pi) -->
      <cla_stall>-2.44</cla_stall> <!-- -0.0427/deg * (180/pi) -->
      <alpha_stall>0.27227</alpha_stall> <!-- 15.6 deg in rad -->
      <cda>0.09740</cda>
      <cda_stall>-0.85371</cda_stall>
      <cma>0.0</cma>
      <cma_stall>0.0</cma_stall>
      <control_joint_name>left_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.0</control_joint_rad_to_cl>
      <robotNamespace></robotNamespace>
      <windSubTopic>world_wind</windSubTopic>
    </plugin>

    <!-- Right aileron wing (NACA-5411) -->
    <plugin name="right_aileron_lift" filename="libLiftDragPlugin.so">
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <area>0.365</area>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>-0.05 -0.3 0.05</cp>
      <a0>0.08727</a0>
      <cla>6.19</cla>
      <cla_stall>-2.44</cla_stall>
      <alpha_stall>0.27227</alpha_stall>
      <cda>0.09740</cda>
      <cda_stall>-0.85371</cda_stall>
      <cma>0.0</cma>
      <cma_stall>0.0</cma_stall>
      <control_joint_name>right_aileron_joint</control_joint_name>
      <control_joint_rad_to_cl>0.0137</control_joint_rad_to_cl>
      <robotNamespace></robotNamespace>
      <windSubTopic>world_wind</windSubTopic>
    </plugin>

    <!-- Left elevator (NACA-0009) -->
    <plugin name="left_elevator_lift" filename="libLiftDragPlugin.so">
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <!-- (219+175)*359/2 ~= 70500mm² = 0.0705m² -->
      <area>0.0705</area>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>-1.0 0.2 -0.05</cp>
      <a0>0</a0>
      <cla>7.02</cla>              <!-- 0.1226/deg * (180/pi) -->
      <cla_stall>-8.02</cla_stall> <!-- -0.1399/deg * (180/pi) -->
      <alpha_stall>0.15708</alpha_stall> <!-- 9 deg in rad -->
      <cda>0.14897</cda>
      <cda_stall>-1.2490</cda_stall>
      <cma>0.0</cma>
      <cma_stall>0.0</cma_stall>
      <control_joint_name>left_elevator_joint</control_joint_name>
      <control_joint_rad_to_cl>-6.0</control_joint_rad_to_cl>
      <robotNamespace></robotNamespace>
      <windSubTopic>world_wind</windSubTopic>
    </plugin>

    <!-- Right elevator (NACA-0009) -->
    <plugin name="right_elevator_lift" filename="libLiftDragPlugin.so">
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <area>0.0705</area>
      <forward>1 0 0</forward>
      <upward>0 0 1</upward>
      <cp>-1.0 -0.2 -0.05</cp>
      <a0>0</a0>
      <cla>7.02</cla>
      <cla_stall>-8.02</cla_stall>
      <alpha_stall>0.15708</alpha_stall>
      <cda>0.14897</cda>
      <cda_stall>-1.2490</cda_stall>
      <cma>0.0</cma>
      <cma_stall>0.0</cma_stall>
      <control_joint_name>right_elevator_joint</control_joint_name>
      <control_joint_rad_to_cl>-6.0</control_joint_rad_to_cl>
      <robotNamespace></robotNamespace>
      <windSubTopic>world_wind</windSubTopic>
    </plugin>

    <!-- Rudder (NACA-0009, vertical airfoil — upward is lateral Y axis)  -->
    <!-- NOTE: the gz-sim source had a duplicate <cp> tag on the rudder    -->
    <!-- plugin (bug). The correct cp is -1.63 0 0.45 (at the rudder),    -->
    <!-- not -1.0 -0.2 -0.05 (which was copied from right_elevator).      -->
    <plugin name="rudder_lift" filename="libLiftDragPlugin.so">
      <link_name>base_link</link_name>
      <air_density>1.225</air_density>
      <area>0.035</area>
      <forward>1 0 0</forward>
      <upward>0 1 0</upward>
      <cp>-1.63 0 0.45</cp>
      <a0>0</a0>
      <cla>7.02</cla>
      <cla_stall>-8.02</cla_stall>
      <alpha_stall>0.15708</alpha_stall>
      <cda>0.14897</cda>
      <cda_stall>-1.2490</cda_stall>
      <cma>0.0</cma>
      <cma_stall>0.0</cma_stall>
      <control_joint_name>rudder_joint</control_joint_name>
      <control_joint_rad_to_cl>-1.0</control_joint_rad_to_cl>
      <robotNamespace></robotNamespace>
      <windSubTopic>world_wind</windSubTopic>
    </plugin>

    <!-- ============================================================ -->
    <!-- MOTOR PLUGINS (libgazebo_motor_model.so)                     -->
    <!-- Translated from gz-sim MulticopterMotorModel.                -->
    <!-- commandSubTopic changed from "command/motor_speed" (gz-sim)  -->
    <!-- to "/gazebo/command/motor_speed" (Gazebo Classic absolute).  -->
    <!-- ============================================================ -->

    <plugin name='front_right_motor_model' filename='libgazebo_motor_model.so'>
      <robotNamespace></robotNamespace>
      <jointName>rotor_0_joint</jointName>
      <linkName>rotor_0</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1055</maxRotVelocity>
      <motorConstant>7.6e-05</motorConstant>
      <momentConstant>0.0205</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>0</motorNumber>
      <rotorDragCoefficient>0.000106428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/0</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
    </plugin>

    <plugin name='back_left_motor_model' filename='libgazebo_motor_model.so'>
      <robotNamespace></robotNamespace>
      <jointName>rotor_1_joint</jointName>
      <linkName>rotor_1</linkName>
      <turningDirection>ccw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1055</maxRotVelocity>
      <motorConstant>7.6e-05</motorConstant>
      <momentConstant>0.0205</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>1</motorNumber>
      <rotorDragCoefficient>0.000106428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/1</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
    </plugin>

    <plugin name='front_left_motor_model' filename='libgazebo_motor_model.so'>
      <robotNamespace></robotNamespace>
      <jointName>rotor_2_joint</jointName>
      <linkName>rotor_2</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1055</maxRotVelocity>
      <motorConstant>7.6e-05</motorConstant>
      <momentConstant>0.0205</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>2</motorNumber>
      <rotorDragCoefficient>0.000106428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/2</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
    </plugin>

    <plugin name='back_right_motor_model' filename='libgazebo_motor_model.so'>
      <robotNamespace></robotNamespace>
      <jointName>rotor_3_joint</jointName>
      <linkName>rotor_3</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>1055</maxRotVelocity>
      <motorConstant>7.6e-05</motorConstant>
      <momentConstant>0.0205</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>3</motorNumber>
      <rotorDragCoefficient>0.000106428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/3</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
    </plugin>

    <plugin name='pusher_motor_model' filename='libgazebo_motor_model.so'>
      <robotNamespace></robotNamespace>
      <jointName>rotor_pusher_joint</jointName>
      <linkName>rotor_pusher</linkName>
      <turningDirection>cw</turningDirection>
      <timeConstantUp>0.0125</timeConstantUp>
      <timeConstantDown>0.025</timeConstantDown>
      <maxRotVelocity>826</maxRotVelocity>
      <motorConstant>1.096e-04</motorConstant>
      <momentConstant>0.02807</momentConstant>
      <commandSubTopic>/gazebo/command/motor_speed</commandSubTopic>
      <motorNumber>4</motorNumber>
      <rotorDragCoefficient>0.000106428</rotorDragCoefficient>
      <rollingMomentCoefficient>1e-06</rollingMomentCoefficient>
      <motorSpeedPubTopic>/motor_speed/4</motorSpeedPubTopic>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
    </plugin>

    <!-- ============================================================ -->
    <!-- SENSOR PLUGINS                                               -->
    <!-- gz-sim embedded sensors replaced with Gazebo Classic plugins -->
    <!-- ============================================================ -->

    <plugin name='gazebo_imu_plugin' filename='libgazebo_imu_plugin.so'>
      <robotNamespace></robotNamespace>
      <linkName>fighter_vtol_hitl/imu_link</linkName>
      <imuTopic>/imu</imuTopic>
    </plugin>

    <plugin name='groundtruth_plugin' filename='libgazebo_groundtruth_plugin.so'>
      <robotNamespace/>
    </plugin>

    <plugin name='magnetometer_plugin' filename='libgazebo_magnetometer_plugin.so'>
      <robotNamespace/>
      <pubRate>100</pubRate>
      <noiseDensity>0.0004</noiseDensity>
      <randomWalk>6.4e-06</randomWalk>
      <biasCorrelationTime>600</biasCorrelationTime>
      <magTopic>/mag</magTopic>
    </plugin>

    <plugin name='barometer_plugin' filename='libgazebo_barometer_plugin.so'>
      <robotNamespace/>
      <pubRate>50</pubRate>
      <baroTopic>/baro</baroTopic>
    </plugin>

    <!-- ============================================================ -->
    <!-- MAVLINK HITL INTERFACE                                       -->
    <!-- hil_mode=1 and serialEnabled=1 enable hardware-in-the-loop. -->
    <!-- Adjust serialDevice and baudRate to match your flight ctrl.  -->
    <!-- Control channels map PX4 HIL_ACTUATOR_CONTROLS outputs to   -->
    <!-- Gazebo Classic joints. input_scaling for motors matches      -->
    <!-- maxRotVelocity; for servos it is 1 (radians passthrough).   -->
    <!-- ============================================================ -->

    <plugin name='mavlink_interface' filename='libgazebo_mavlink_interface.so'>
      <robotNamespace/>
      <imuSubTopic>/imu</imuSubTopic>
      <magSubTopic>/mag</magSubTopic>
      <gpsSubTopic>/gps0</gpsSubTopic>
      <baroSubTopic>/baro</baroSubTopic>
      <mavlink_addr>INADDR_ANY</mavlink_addr>
      <mavlink_udp_port>14560</mavlink_udp_port>
      <mavlink_tcp_port>4560</mavlink_tcp_port>
      <serialEnabled>1</serialEnabled>
      <serialDevice>/dev/ttyACM0</serialDevice>
      <baudRate>921600</baudRate>
      <qgc_addr>INADDR_ANY</qgc_addr>
      <qgc_udp_port>14550</qgc_udp_port>
      <sdk_addr>INADDR_ANY</sdk_addr>
      <sdk_udp_port>14540</sdk_udp_port>
      <hil_mode>1</hil_mode>
      <hil_state_level>0</hil_state_level>
      <send_vision_estimation>0</send_vision_estimation>
      <send_odometry>1</send_odometry>
      <enable_lockstep>0</enable_lockstep>
      <use_tcp>1</use_tcp>
      <motorSpeedCommandPubTopic>/gazebo/command/motor_speed</motorSpeedCommandPubTopic>
      <control_channels>
        <!-- Motors 0-3: hover rotors (normalized 0..1, scaled to rad/s) -->
        <channel name="rotor0">
          <input_index>0</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1055</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
          <joint_name>rotor_0_joint</joint_name>
        </channel>
        <channel name="rotor1">
          <input_index>1</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1055</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
          <joint_name>rotor_1_joint</joint_name>
        </channel>
        <channel name="rotor2">
          <input_index>2</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1055</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
          <joint_name>rotor_2_joint</joint_name>
        </channel>
        <channel name="rotor3">
          <input_index>3</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1055</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
          <joint_name>rotor_3_joint</joint_name>
        </channel>
        <!-- Motor 4: pusher -->
        <channel name="rotor_pusher">
          <input_index>4</input_index>
          <input_offset>0</input_offset>
          <input_scaling>826</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>velocity</joint_control_type>
          <joint_name>rotor_pusher_joint</joint_name>
        </channel>
        <!-- Servos 5-9: control surfaces (normalized -1..1 → joint position rad) -->
        <!-- Corresponds to gz-sim JointPositionController servo_0..servo_4 -->
        <channel name="left_aileron">
          <input_index>5</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>left_aileron_joint</joint_name>
        </channel>
        <channel name="right_aileron">
          <input_index>6</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>right_aileron_joint</joint_name>
        </channel>
        <channel name="left_elevator">
          <input_index>7</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>left_elevator_joint</joint_name>
        </channel>
        <channel name="right_elevator">
          <input_index>8</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>right_elevator_joint</joint_name>
        </channel>
        <channel name="rudder">
          <input_index>9</input_index>
          <input_offset>0</input_offset>
          <input_scaling>1</input_scaling>
          <zero_position_disarmed>0</zero_position_disarmed>
          <zero_position_armed>0</zero_position_armed>
          <joint_control_type>position_kinematic</joint_control_type>
          <joint_name>rudder_joint</joint_name>
        </channel>
      </control_channels>
    </plugin>

    <static>0</static>
  </model>
</sdf>
