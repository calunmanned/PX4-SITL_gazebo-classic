        </material>
      </visual>
    </link>
    <joint name='right_elevator_joint' type='revolute'>
      <pose>0.75 0 -0.016 0 0 0</pose>
      <parent>base_link</parent>
      <child>right_elevator</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-0.78</lower>
          <upper>0.78</upper>
        </limit>
        <dynamics>
          <damping>1.000</damping>
        </dynamics>
      </axis>
      <physics>
        <ode>
