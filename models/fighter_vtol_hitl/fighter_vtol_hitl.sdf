        <pose>1.683 0.062 0.000 0 0 0</pose>
        <geometry>
          <mesh>
            <scale>0.001 0.001 0.001</scale>
            <uri>model://fighter_vtol_hitl/meshes/gz_fighter_vtol_right_elevator_v2.dae</uri>
          </mesh>
        </geometry>
        <material>
          <ambient>0 0 1 1.0</ambient>
