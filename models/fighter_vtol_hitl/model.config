<?xml version="1.0"?>
<model>
  <name>Fighter VTOL HITL</name>
  <version>1.0</version>
  <sdf version='1.5'>fighter_vtol_hitl.sdf</sdf>

  <author>
   <name>Gaofeng Su</name>
   <email>koufongso@berkeley.edu</email>
  </author>

  <description>
    This is a HITL model of a fighter 4+1 VTOL (designed and manufactured by Makeflyeasy),
    adapted for Gazebo Classic from the gz-sim fighter_vtol model.
    Mesh files are referenced from model://fighter_vtol — ensure that model is in GAZEBO_MODEL_PATH.
  </description>
</model>
